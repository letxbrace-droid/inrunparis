# Render output and the vendored CLI deps — regenerate with
#   cd composition && npx hyperframes render --output ../brag.mp4
composition/node_modules
composition/.hyperframes
*.mp4
*.jpg

# Verification frames — regenerate with
#   cd composition && npx hyperframes snapshot --at <times> --output ../snapshots
snapshots

# In-flight render scratch — hyperframes cleans these up itself on success,
# but a cancelled or interrupted render leaves them behind
.*.hf-transaction-*
work-*/
